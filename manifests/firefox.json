{
  "manifest_version": 3,
  "name": "GhostVault",
  "version": "0.1.0",
  "description": "Local-first private password vault. Your credentials, encrypted, always on-device.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ghostvault@local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["storage", "alarms"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GhostVault",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
